{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://dev.platform.lernium.ru"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://dev.platform.lernium.ru"
      }
    },
    "simulator": {
      "extends": "preview",
      "environment": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://lernium.ru"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
