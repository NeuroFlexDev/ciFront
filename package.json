{
  "name": "markdown-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "katex": "$katex"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.5",
    "@mui/material": "^6.4.5",
    "@reduxjs/toolkit": "^2.5.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-color": "3.32.0",
    "@tiptap/extension-font-family": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@uiw/react-codemirror": "^4.23.8",
    "@xyflow/react": "^12.10.2",
    "codemirror": "^6.0.1",
    "daisyui": "^4.12.23",
    "dompurify": "3.4.17",
    "jspdf": "^4.2.1",
    "katex": "0.19.0",
    "lucide-react": "^0.475.0",
    "mermaid": "12.2.0",
    "radix-ui": "^1.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.3",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "^4.0.7",
    "zustand": "^5.0.12",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "mdast-util-to-markdown": "2.2.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.4.5",
    "vitest": "4.1.12"
  }
}
